  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": "..",
    "paths": {
      "npm:@supabase/supabase-js@2": ["../node_modules/@supabase/supabase-js"],
      "npm:@anthropic-ai/sdk": ["../node_modules/@anthropic-ai/sdk"]
